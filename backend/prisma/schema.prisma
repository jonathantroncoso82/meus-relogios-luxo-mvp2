// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  senha     String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relogios   Relogio[]
  colecoes   Colecao[]
  manutencoes Manutencao[]
  seguros    Seguro[]
  avaliacoes Avaliacao[]
  registrosServico RegistroServico[]
  avaliacoes_criadas Avaliacao[] @relation("AvaliacaoCriador")
}

model Relogio {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  marcaId   Int
  marca     Marca   @relation(fields: [marcaId], references: [id])
  colecaoId Int?
  colecao   Colecao? @relation(fields: [colecaoId], references: [id], onDelete: SetNull)
  
  modelo    String
  referencia String?
  anoFabricacao Int?
  descricao String?
  preco     Decimal @db.Decimal(10, 2)
  condicao  String @default("novo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manutencoes Manutencao[]
  seguros    Seguro[]
  avaliacoes Avaliacao[]
  registrosServico RegistroServico[]
}

model Marca {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  pais      String?
  fundacao  Int?
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relogios  Relogio[]
}

model Colecao {
  id        Int     @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  nome      String
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relogios  Relogio[]
}

model Manutencao {
  id        Int     @id @default(autoincrement())
  relogioId Int
  relogio   Relogio @relation(fields: [relogioId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  
  tipo      String
  data      DateTime
  descricao String?
  custo     Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seguro {
  id        Int     @id @default(autoincrement())
  relogioId Int
  relogio   Relogio @relation(fields: [relogioId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  
  numero    String  @unique
  valor     Decimal @db.Decimal(10, 2)
  dataInicio DateTime
  dataFim   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Avaliacao {
  id        Int     @id @default(autoincrement())
  relogioId Int
  relogio   Relogio @relation(fields: [relogioId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  criadorId Int
  criador   Usuario @relation("AvaliacaoCriador", fields: [criadorId], references: [id])
  
  valor     Decimal @db.Decimal(10, 2)
  data      DateTime
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistroServico {
  id        Int     @id @default(autoincrement())
  relogioId Int
  relogio   Relogio @relation(fields: [relogioId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  
  dataServico DateTime
  tipoServico String
  descricao   String?
  custo       Decimal @db.Decimal(10, 2)
  tecnico     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
