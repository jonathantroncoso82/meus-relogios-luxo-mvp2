// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  password  String
  name      String
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  watches       Watch[]
  collections   Collection[]
  maintenances  Maintenance[]
  insurances    Insurance[]
  valuations    Valuation[]

  @@map("usuarios")
}

model Watch {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  brand           String
  model           String
  reference       String?
  yearProduction  Int?
  type            String?
  material        String?
  caseSize        String?
  movement        String?
  condition       String?
  estimatedPrice  Decimal? @db.Decimal(12, 2)
  description     String?
  imageUrl        String?
  acquisitionDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  active          Boolean  @default(true)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenances Maintenance[]
  insurances   Insurance[]
  valuations   Valuation[]

  @@index([userId])
  @@index([brand])
  @@index([active])
  @@map("relogios")
}

model Collection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  name            String
  description     String?
  theme           String?
  watchCount      Int      @default(0)
  totalValue      Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  active          Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@map("colecoes")
}

model Maintenance {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchId          String   @db.Uuid
  userId           String   @db.Uuid
  serviceType      String
  description      String?
  serviceDate      DateTime
  completionDate   DateTime?
  cost             Decimal? @db.Decimal(10, 2)
  serviceProvider  String?
  status           String   @default("pendente")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  active           Boolean  @default(true)

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@index([userId])
  @@index([status])
  @@index([active])
  @@map("manutencoes")
}

model Insurance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchId         String   @db.Uuid
  userId          String   @db.Uuid
  policyNumber    String   @unique
  insurer         String
  coverageValue   Decimal  @db.Decimal(12, 2)
  annualPremium   Decimal? @db.Decimal(10, 2)
  startDate       DateTime
  expirationDate  DateTime
  status          String   @default("ativo")
  coverageType    String?
  deductible      Decimal? @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  active          Boolean  @default(true)

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@index([userId])
  @@index([policyNumber])
  @@index([status])
  @@index([active])
  @@map("seguros")
}

model Valuation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watchId         String   @db.Uuid
  userId          String   @db.Uuid
  appraiser       String
  valuationDate   DateTime
  valuedAmount    Decimal  @db.Decimal(12, 2)
  generalCondition String?
  functionality   String?
  authenticity    String?
  rarity          String?
  marketDemand    String?
  report          String?
  certificateNumber String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  active          Boolean  @default(true)

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([watchId])
  @@index([userId])
  @@index([active])
  @@map("avaliacoes")
}
