{
  "name": "relogios-backend",
  "version": "1.0.0",
  "description": "API backend para Controle de Colecção de Relógios de Luxo",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "5.10.2",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.3",
    "express-validator": "7.0.1",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/morgan": "1.9.9",
    "@types/node": "20.11.30",
    "prisma": "5.10.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.3"
  }
}
